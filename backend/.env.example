# Copy this file to .env and fill in the values. Never commit .env.

# ---- the single login --------------------------------------------------------
SMARTSTOCK_USERNAME=admin
SMARTSTOCK_PASSWORD=change-this-password
SMARTSTOCK_DISPLAY_NAME=A to Z Vending
# long random string used to sign session tokens; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMARTSTOCK_SECRET_KEY=
SMARTSTOCK_TOKEN_HOURS=12

# ---- web access --------------------------------------------------------------
# the frontend's address(es), comma-separated (needed for direct file uploads from the browser)
SMARTSTOCK_CORS_ORIGINS=http://localhost:3000
# the address the browser uses to reach THIS server (used to build one-time upload links)
SMARTSTOCK_PUBLIC_BASE_URL=http://localhost:8000
SMARTSTOCK_API_PREFIX=/api/v1

# ---- folders (defaults: ./data and ./models) ---------------------------------
# SMARTSTOCK_DATA_DIR=./data
# SMARTSTOCK_MODELS_DIR=./models
# SMARTSTOCK_TRAINING_SCRIPT=./training/smartstock_training.py
# Python used for retraining jobs (default: the one running the server)
# SMARTSTOCK_PYTHON=

# ---- forecasting -------------------------------------------------------------
SMARTSTOCK_TIMEZONE=Australia/Sydney
# Pretend today is this date (YYYY-MM-DD). Leave empty in normal use.
# Useful for a demo: 2026-09-01 shows the forecast as if the data were brand new.
SMARTSTOCK_TODAY=
SMARTSTOCK_MAX_UPLOAD_MB=50
SMARTSTOCK_UPLOAD_TICKET_MINUTES=10
# accuracy monitoring: warn when live error exceeds the backtest error by more than this
SMARTSTOCK_DRIFT_MARGIN=0.10
