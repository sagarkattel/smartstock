# Copy to .env.local and adjust. Never commit .env*.local.

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# The FastAPI backend, including its prefix. Start it first: see the backend README (./run.sh).
SMARTSTOCK_API_URL=http://localhost:8000/api/v1
# Name of the httpOnly session cookie
SESSION_COOKIE_NAME=smartstock_session
# Fallback session lifetime in seconds (the backend normally sets it)
SESSION_MAX_AGE_SECONDS=43200

# --- Visible to the browser ---
NEXT_PUBLIC_APP_TITLE=SmartStock
